// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === Enums ===

// Role-Based Access Control System
// Roles are hierarchical: READER < SUBSCRIBER < AUTHOR < MODERATOR < ADMIN
enum Role {
  READER // Unauthenticated user privileges
  SUBSCRIBER // Base authenticated role
  AUTHOR // Can publish poems immediately
  MODERATOR // Can manage categories, moderate content, approve author requests
  ADMIN // Full system access
}

// Status for user-generated content that requires moderation
enum ContentApprovalStatus {
  PENDING // Awaiting moderator review (for non-authors)
  APPROVED // Approved and published (default for Authors)
  REJECTED // Rejected by moderator
  PENDINGREVIEW // Pending review due to a claim report
}

// Status for user accounts managed by moderators/admins
enum UserAccountStatus {
  ACTIVE
  SUSPENDED // Temporary ban
  BANNED // Permanent ban
}

// Translation item types
enum TranslationItemType {
  POEM_TAGS
  POEM_CATEGORY
}

// Locales
enum Locale {
  EN
  RU
  UA
}

// Resource types for claim reports
enum ClaimResourceType {
  POEM
  COMMENT
  REVIEW
}

// === Core Models for Authentication (Auth.js / NextAuth) ===

// User model for authentication and profile information
model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String? // URL to avatar
  password      String? // Hashed password for Credentials provider (optional)
  role          Role              @default(SUBSCRIBER) // Default role assigned on first login
  status        UserAccountStatus @default(ACTIVE) // Account status for moderation

  // Multilingual profile bio
  // Using separate fields for simplicity in MVP. Can be extended to a separate model later.
  bio   Json? // Rich text content from WYSIWYG editor as JSON
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accounts               Account[]
  poems                  Poem[]
  comments               Comment[]
  ratings                Rating[]
  reviews                Review[]
  readingLists           ReadingList[]
  authorRequests         AuthorRoleRequest[] @relation("AuthorRequests") // Requests made by this user
  authorRequestApprovals AuthorRoleRequest[] @relation("AuthorRequestApprovals") // Requests approved/rejected by this user (if Moderator/Admin)
  claimReports           ClaimReport[]       @relation("ClaimReporter") // Claims reported by this user
  handledClaims          ClaimReport[]       @relation("ClaimHandler") // Claims handled by this user (Moderator/Admin)
  moderationActivities   ModerationActivity[] @relation("ModeratorActivities") // Activities performed by this user
  targetUserActivities   ModerationActivity[] @relation("TargetUserActivities") // Activities affecting this user
}

// Account model for storing linked OAuth accounts and Credentials info
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String // "oauth", "email", "credentials"
  provider          String // "google", "credentials"
  providerAccountId String // Unique ID from the provider
  refresh_token     String? // OAuth refresh token
  access_token      String? // OAuth access token
  expires_at        Int? // OAuth token expiration timestamp
  token_type        String? // OAuth token type
  scope             String? // OAuth scopes
  id_token          String? // OAuth ID token
  session_state     String? // OAuth session state

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Verification tokens for password reset, email verification, etc.
model VerificationToken {
  identifier String
  token      String   @id
  expires    DateTime

  @@unique([identifier, token])
}

// === Core Models for Poetry Platform ===

// Model for poem categories, supporting multilingual names
model Statistics {
  id        String @id @default(cuid())
  poemId    String @unique
  poem      Poem   @relation("PoemStatistics", fields: [poemId], references: [id], onDelete: Cascade)
  views     Int    @default(0)
  edits     Int    @default(0)
  likes     Int    @default(0)
  shares    Int    @default(0)

  @@index([views])
  @@index([edits])
  @@index([likes])
  @@index([shares])
  @@index([poemId]) // Index for faster search by poemId
}

model Category {
  id                String         @id @default(cuid())
  slug              String         @unique // SEO-friendly URL slug
  isActive          Boolean        @default(true)
  order             Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  translatedItems   TranslatedItem[]
  poems             Poem[]         @relation("PoemCategory")
  @@index([isActive, order])
  @@index([slug])
}

model TranslatedItem {
  id        String              @id @default(cuid())
  type      TranslationItemType
  values    Json                // { "EN": "value", "RU": "value", "UA": "value" }
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  categoryId    String?           // Внешний ключ, nullable для поддержки других типов переводов
  category      Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@index([type])               // Индекс для быстрого поиска по типу
}

model Tag {
  id            String    @id @default(cuid())
  nameId        String    @unique // Tag name should be unique
  name          String    @unique // Tag name should be unique
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Relations
  poems         Poem[]
  @@index([name]) // Index for efficient tag lookup
}

// Main model for poems
model Poem {
  id          String                @id @default(cuid())
  slug        String                @unique
  title       String
  content     Json // Rich text content from WYSIWYG editor as JSON
  description String? // Optional short description
  authorId    String
  author      User                  @relation(fields: [authorId], references: [id])
  status      ContentApprovalStatus @default(APPROVED) // Authors: APPROVED; Others: PENDING
  categoryId  String?
  category    Category?             @relation("PoemCategory", fields: [categoryId], references: [id])
  tags        Tag[] // Many-to-many relation via implicit join table
  statistics  Statistics?           @relation("PoemStatistics")

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime? // When the poem was first published

  // Relations
  comments        Comment[]
  ratings         Rating[]
  reviews         Review[]
  claimReports    ClaimReport[] @relation("PoemClaims")
  ReadingListItem ReadingListItem[]

  @@index([authorId]) // Index for finding poems by author
  @@index([status]) // Index for filtering by approval status
  @@index([createdAt]) // Index for sorting by creation date
  @@index([publishedAt]) // Index for sorting by publication date
}

// Model for user comments on poems
model Comment {
  id       String                @id @default(cuid())
  content  String // The comment text
  poemId   String
  poem     Poem                  @relation(fields: [poemId], references: [id], onDelete: Cascade)
  authorId String
  author   User                  @relation(fields: [authorId], references: [id])
  status   ContentApprovalStatus @default(APPROVED) // Default to APPROVED on creation

  // Moderation fields
  isApproved Boolean @default(true) // Simple moderation flag for MVP

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  claimReports ClaimReport[] @relation("CommentClaims")

  @@index([poemId]) // Index for finding comments on a poem
  @@index([authorId]) // Index for finding comments by a user
  @@index([createdAt]) // Index for sorting comments
  @@index([isApproved]) // Index for filtering approved comments
  @@index([status]) // Index for filtering by approval status
}

// Model for poem ratings (1-5 stars)
model Rating {
  id     String @id @default(cuid())
  value  Int // Rating value (1-5)
  poemId String
  poem   Poem   @relation(fields: [poemId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, poemId]) // A user can only rate a poem once
  @@index([poemId]) // Index for calculating average rating for a poem
  @@index([value]) // Index for filtering by rating value
}

// Model for detailed poem reviews
model Review {
  id      String                @id @default(cuid())
  title   String? // Optional title for the review
  content String // The review text
  rating  Int? // Optional rating value (1-5)
  poemId  String
  poem    Poem                  @relation(fields: [poemId], references: [id])
  userId  String
  user    User                  @relation(fields: [userId], references: [id])
  status  ContentApprovalStatus @default(APPROVED) // Default to APPROVED on creation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  claimReports ClaimReport[] @relation("ReviewClaims")

  @@unique([userId, poemId]) // A user can only review a poem once
  @@index([poemId]) // Index for finding reviews for a poem
  @@index([userId]) // Index for finding reviews by a user
  @@index([status]) // Index for filtering by approval status
}

// Model for user reading lists/collections
model ReadingList {
  id          String  @id @default(cuid())
  name        String // Name of the list
  description String? // Optional description
  ownerId     String
  owner       User    @relation(fields: [ownerId], references: [id], onDelete: Cascade) // Delete list if owner is deleted

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items ReadingListItem[]

  @@index([ownerId]) // Index for finding lists by owner
  @@index([createdAt]) // Index for sorting lists
}

// Join model for items in a reading list
model ReadingListItem {
  id            String      @id @default(cuid())
  readingListId String
  readingList   ReadingList @relation(fields: [readingListId], references: [id], onDelete: Cascade) // Delete list if list is deleted
  poemId        String
  poem          Poem        @relation(fields: [poemId], references: [id], onDelete: Cascade)

  // Allows ordering items within a list
  order Int @default(0)

  createdAt DateTime @default(now())

  @@unique([readingListId, poemId]) // A poem can only be added once to a specific list
  @@index([readingListId, order]) // Index for efficient retrieval and ordering of list items
}

// Model for subscribers requesting author role
model AuthorRoleRequest {
  id          String  @id @default(cuid())
  requesterId String // The user requesting the role
  requester   User    @relation("AuthorRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  // The user (Moderator/Admin) who approved or rejected the request
  reviewerId  String?
  reviewer    User?   @relation("AuthorRequestApprovals", fields: [reviewerId], references: [id])
  status      String // e.g., "PENDING", "APPROVED", "REJECTED"
  message     String? // Optional message from requester
  response    String? // Optional response/reason from reviewer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId]) // Index for finding requests by user
  @@index([status]) // Index for filtering requests by status
  @@index([createdAt]) // Index for sorting requests
}

// Model for claim reports on poems, comments, or reviews
model ClaimReport {
  id                    String                @id @default(cuid())
  resourceType          ClaimResourceType // Type of resource (POEM, COMMENT, REVIEW)
  poemId                String? // Nullable if not a poem
  poem                  Poem?   @relation("PoemClaims", fields: [poemId], references: [id], onDelete: Cascade)
  commentId             String? // Nullable if not a comment
  comment               Comment? @relation("CommentClaims", fields: [commentId], references: [id], onDelete: Cascade)
  reviewId              String? // Nullable if not a review
  review                Review? @relation("ReviewClaims", fields: [reviewId], references: [id], onDelete: Cascade)
  message               String // User's message about the claim
  reporterId            String? // Nullable for unauthenticated users
  reporter              User?   @relation("ClaimReporter", fields: [reporterId], references: [id])
  claimResultDecision   ContentApprovalStatus? // APPROVED, REJECTED, or null if pending
  claimResultDecisionAt DateTime? // Timestamp of decision
  claimApproveDecisionReason String? // Reason for approving the claim
  handlerId             String? // ID of Moderator/Admin who handled the claim
  handler               User?   @relation("ClaimHandler", fields: [handlerId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for performance
  @@index([resourceType])
  @@index([reporterId])
  @@index([handlerId])
  @@index([claimResultDecision])
  @@index([createdAt])
  @@index([poemId])
  @@index([commentId])
  @@index([reviewId])
}

// Model for logging moderation activities
model ModerationActivity {
  id          String   @id @default(cuid())
  activityType String  // Type of moderation activity (e.g., "APPROVE_CLAIM", "REJECT_CLAIM", "SUSPEND_USER", "BAN_USER")
  description String   // Description of the activity
  moderatorId String   // ID of the moderator who performed the activity
  moderator   User     @relation("ModeratorActivities", fields: [moderatorId], references: [id])
  targetUserId String? // ID of the user affected by the activity (if applicable)
  targetUser   User?   @relation("TargetUserActivities", fields: [targetUserId], references: [id])
  resourceType String? // Type of resource affected (e.g., "POEM", "COMMENT", "REVIEW")
  resourceId   String? // ID of the resource affected
  metadata     Json?   // Additional metadata about the activity

  // Timestamps
  createdAt DateTime @default(now())

  // Indexes for performance
  @@index([activityType])
  @@index([moderatorId])
  @@index([targetUserId])
  @@index([createdAt])
}
